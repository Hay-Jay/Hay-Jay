{%- assign mono = "'Courier Prime','Courier New',Courier,monospace" -%}
{%- assign type = "'Special Elite','Courier New',Courier,monospace" -%}
{%- assign head = "'Big Shoulders Display',Impact,'HelveticaNeue-CondensedBlack',sans-serif-condensed,Arial,sans-serif" -%}
{%- assign stencil = "'Stardos Stencil',Impact,Arial,sans-serif" -%}
{%- assign got_issue = false -%}
{%- for line in line_items -%}{%- if line.product_id == 15418664059134 -%}{%- assign got_issue = true -%}{%- endif -%}{%- endfor -%}
{%- comment -%} payment: still processing (or waiting on the buyer) means the order is received, not confirmed {%- endcomment -%}
{%- assign pending = false -%}
{%- if has_pending_payment -%}{%- assign pending = true -%}{%- endif -%}
{%- comment -%} delivery mode: ship (to an address), pickup, none (nothing ships). local = local delivery, which goes "out for delivery" {%- endcomment -%}
{%- assign mode = 'none' -%}
{%- if requires_shipping -%}
  {%- if delivery_method == 'pick-up' -%}{%- assign mode = 'pickup' -%}
  {%- elsif shipping_address -%}{%- assign mode = 'ship' -%}
  {%- else -%}{%- assign mode = 'pickup' -%}{%- endif -%}
{%- endif -%}
{%- assign local = false -%}
{%- if mode == 'ship' and delivery_method == 'local' -%}{%- assign local = true -%}{%- endif -%}
{%- comment -%} the locker, from the order number: row A-H, slot 00-99 (#106901 is F-01) {%- endcomment -%}
{%- assign lk_i = order_number | modulo: 8 -%}
{%- assign lk_n = order_number | modulo: 100 | prepend: '0' | slice: -2, 2 -%}
{%- assign locker = 'ABCDEFGH' | slice: lk_i | append: '-' | append: lk_n -%}
{%- assign n_items = subtotal_line_items.size -%}
{%- assign n_pad = n_items | prepend: '0' | slice: -2, 2 -%}
{%- assign agent = 'Agent' -%}
{%- if customer.first_name != blank -%}{%- assign agent = customer.first_name | escape | prepend: 'Agent ' -%}{%- endif -%}
{%- assign logged_d = created_at | date: "%d %b %Y" -%}
{%- comment -%} totals: order-level discounts (all items) and the sum of the line prices, to decide how the receipt adds up {%- endcomment -%}
{%- assign od_total = 0 -%}
{%- for d in discount_applications -%}{%- if d.target_selection == 'all' and d.target_type == 'line_item' -%}{%- assign od_total = od_total | plus: d.total_allocated_amount -%}{%- endif -%}{%- endfor -%}
{%- assign lines_total = 0 -%}
{%- for line in subtotal_line_items -%}{%- assign lines_total = lines_total | plus: line.final_line_price -%}{%- endfor -%}
{%- assign split = false -%}
{%- if od_total > 0 and lines_total > subtotal_price -%}{%- assign split = true -%}{%- endif -%}
{%- comment -%} shipping: shipping_price is before shipping discounts (as in Shopify's default template); clamp at 0 {%- endcomment -%}
{%- assign ship_disc = 0 -%}
{%- for d in discount_applications -%}{%- if d.target_type == 'shipping_line' -%}{%- assign ship_disc = ship_disc | plus: d.total_allocated_amount -%}{%- endif -%}{%- endfor -%}
{%- assign ship_net = shipping_price | minus: ship_disc -%}
{%- if ship_net < 0 -%}{%- assign ship_net = 0 -%}{%- endif -%}
{%- assign duties = current_total_duties | default: total_duties | default: 0 -%}
{%- comment -%} "City, Country" and "Name, City PR, Country" without stray commas when a part is blank; customer-typed, so escaped {%- endcomment -%}
{%- capture parts -%}{{ shipping_address.city | escape }}|{{ shipping_address.country | escape }}{%- endcapture -%}
{%- assign dest = '' -%}
{%- assign parts = parts | split: '|' -%}
{%- for part in parts -%}{%- assign p = part | strip -%}{%- if p != blank -%}{%- if dest != blank -%}{%- assign dest = dest | append: ', ' -%}{%- endif -%}{%- assign dest = dest | append: p -%}{%- endif -%}{%- endfor -%}
{%- if dest == blank -%}{%- assign dest = shipping_address.address1 | escape -%}{%- endif -%}
{%- capture parts -%}{{ billing_address.name | escape }}|{{ billing_address.city | escape }} {{ billing_address.province_code | escape }}|{{ billing_address.country | escape }}{%- endcapture -%}
{%- assign billed = '' -%}
{%- assign parts = parts | split: '|' -%}
{%- for part in parts -%}{%- assign p = part | strip -%}{%- if p != blank -%}{%- if billed != blank -%}{%- assign billed = billed | append: ', ' -%}{%- endif -%}{%- assign billed = billed | append: p -%}{%- endif -%}{%- endfor -%}
{%- capture sec -%}<span style="display:inline-block;width:18px;height:7px;background:#e8e8e8;background-image:linear-gradient(#e8e8e8,#e8e8e8);vertical-align:1px;"></span>&nbsp;&nbsp;{%- endcapture -%}
<body style="margin:0;padding:0;background:#060606;">
<div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">{% if pending %}Order {{ order_name }} received: {{ total_price | money_with_currency }}. {% if buyer_action_required %}You'll get a confirmation email after completing your payment.{% else %}Your payment is being processed. We'll email you once your order is confirmed.{% endif %}{% else %}Order {{ order_name }} is confirmed: {{ total_price | money_with_currency }}{% if mode == 'ship' %}, going to {{ dest }}. {% if local %}We'll email you when it's out for delivery.{% else %}We'll email you the moment it ships.{% endif %}{% elsif mode == 'pickup' %}, for pickup. We'll email you when it's ready to collect.{% else %}. Nothing to ship: it's all on file.{% endif %}{% endif %}&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#060606" style="background:#060606;">
<tr><td class="outer" align="center" style="padding:24px 8px;">
<!--[if mso]><table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table role="presentation" class="wrap" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#171717" style="width:100%;max-width:600px;background:#171717;border:1px solid #2c2c2c;">

  <!-- classification banner -->
  <tr><td class="ls" align="center" bgcolor="#000000" style="background:#000000;padding:7px 10px 6px;font:bold 10px/14px {{ mono }};letter-spacing:3px;text-transform:uppercase;color:#f0f0f0;"><span style="white-space:nowrap;">Eyes only &nbsp;//</span>&nbsp; <span style="white-space:nowrap;">Monochrome Bureau</span><span class="hn"><span style="white-space:nowrap;">&nbsp; //</span>&nbsp; <span style="white-space:nowrap;">Evidence</span></span></td></tr>

  <!-- dossier bar (the wordmark sits on its own #0d0d0d plate, so it stays a dark badge if a dark mode inverts the bar) -->
  <tr><td class="pxw" bgcolor="#0d0d0d" style="background:#0d0d0d;padding:10px 24px 8px 18px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
      <td valign="middle" width="50%" style="width:50%;font-size:0;line-height:0;"><a href="{{ shop.url }}" target="_blank"><img class="wm" src="https://cdn.shopify.com/s/files/1/0691/1252/9150/files/order-email-oc-wordmark.png?v=1792625021" width="162" height="26" alt="MONOCHROME" style="display:block;width:100%;max-width:162px;height:auto;border:0;color:#ececec;font:900 18px/26px {{ head }};letter-spacing:3px;"></a></td>
      <td class="ls" valign="middle" align="right" style="padding-left:10px;font:bold 11px/14px {{ mono }};letter-spacing:2.5px;text-transform:uppercase;color:#a9a9a9;">Requisitions desk</td>
    </tr></table>
  </td></tr>
  <tr><td height="4" bgcolor="#e8e8e8" style="background:#e8e8e8;height:4px;font-size:0;line-height:0;">&nbsp;</td></tr>

  <!-- hero: the headline, and the RECEIVED stamp thunking on. Two inline-block columns: side by side from 518px, stacked below
       that when a client drops the media queries -->
  <tr><td class="px hero" style="padding:30px 24px 0;font-size:0;line-height:0;">
    <!--[if mso]><table role="presentation" width="518" cellpadding="0" cellspacing="0" border="0"><tr><td width="278" valign="bottom"><![endif]-->
    <div class="hh" style="display:inline-block;width:100%;max-width:278px;vertical-align:bottom;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr><td class="ls" style="font:bold 12px/16px {{ mono }};letter-spacing:3px;text-transform:uppercase;color:#ececec;"><span style="color:#ff3b30;">&#9679;</span>&nbsp; {% if pending %}Order received{% else %}Order confirmed{% endif %}</td></tr>
        <tr><td class="h1 fh" style="padding:14px 0 0;font:900 58px/54px {{ head }};letter-spacing:.5px;text-transform:uppercase;color:#ececec;">{% if pending %}Logged.<br>Tagged.<br>Almost yours.{% else %}Bagged.<br>Tagged.<br>Yours.{% endif %}</td></tr>
      </table>
    </div><!--[if mso]></td><td width="240" valign="bottom" align="right"><![endif]--><div class="hs" style="display:inline-block;width:100%;max-width:240px;vertical-align:bottom;"><img class="sti" src="https://cdn.shopify.com/s/files/1/0691/1252/9150/files/order-email-oc-stamp.gif?v=1792625021" width="240" height="150" alt="RECEIVED" style="display:block;width:100%;max-width:240px;height:auto;margin:0 0 0 auto;border:0;color:#ff3b30;font:bold 14px/20px {{ mono }};letter-spacing:2px;text-align:center;"></div>
    <!--[if mso]></td></tr></table><![endif]-->
  </td></tr>

  <!-- the memo (the site's "TO: OPERATIVE (THAT IS YOU)") -->
  <tr><td class="px" style="padding:22px 24px 0;">
    <table role="presentation" class="memo" width="100%" cellpadding="0" cellspacing="0" border="0" style="font:15px/22px {{ type }};text-transform:uppercase;color:#e4e4e4;">
      <tr><td class="ml" width="78" valign="top" style="width:78px;font:bold 11px/22px {{ mono }};letter-spacing:2px;color:#8f8f8f;">To:</td><td>{{ agent }} <span style="color:#8f8f8f;">(that is you)</span></td></tr>
      <tr><td valign="top" style="font:bold 11px/22px {{ mono }};letter-spacing:2px;color:#8f8f8f;">From:</td><td>Requisitions desk</td></tr>
      <tr><td valign="top" style="font:bold 11px/22px {{ mono }};letter-spacing:2px;color:#8f8f8f;">Status:</td><td>{% if pending %}{% if buyer_action_required %}Awaiting your payment{% else %}Payment processing{% endif %}{% else %}<span style="color:#8f8f8f;text-decoration:line-through;">Pending</span> Confirmed{% endif %}</td></tr>
      <tr><td valign="top" style="font:bold 11px/22px {{ mono }};letter-spacing:2px;color:#8f8f8f;">Motive:</td><td><span aria-hidden="true" style="background:#d6d6d6;background-image:linear-gradient(#d6d6d6,#d6d6d6);">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> <span style="font:bold 11px/18px {{ mono }};letter-spacing:1px;color:#8f8f8f;white-space:nowrap;">&#8627; Declassified:</span> <span style="font:bold 11px/18px {{ mono }};letter-spacing:1px;color:#8f8f8f;white-space:nowrap;">excellent taste.</span></td></tr>
    </table>
  </td></tr>
  <tr><td class="px lede" style="padding:16px 24px 0;font:15px/24px {{ mono }};color:#d9d9d9;">Thank you for your order. {% if pending %}It's logged and held for you. {% if buyer_action_required %}You'll get a confirmation email after completing your payment.{% else %}Your payment is being processed. You'll get an email when your order is confirmed.{% endif %}{% elsif mode == 'ship' %}It's logged into evidence and sealed until dispatch. {% if local %}We'll email you when it's out for delivery.{% else %}We'll email you the moment it ships.{% endif %}{% elsif mode == 'pickup' %}It's logged into evidence and held for you. We'll email you when it's ready to collect.{% else %}It's logged into evidence. Nothing to ship: it's all on file.{% endif %}</td></tr>

  <!-- case plate: the facts at a glance (the site's file header) -->
  <tr><td class="px" style="padding:22px 24px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#0d0d0d" style="background:#0d0d0d;border:2px solid #e8e8e8;">
      <tr><td width="42%" valign="top" style="width:42%;padding:12px 14px 12px;border-right:1px solid #e8e8e8;border-bottom:1px solid #e8e8e8;">
          <div style="font:bold 10px/14px {{ mono }};letter-spacing:2.5px;text-transform:uppercase;color:#a9a9a9;">Order no.</div>
          <div class="val fh" style="font:900 24px/30px {{ head }};letter-spacing:.5px;color:#ffffff;word-break:break-all;">{{ order_name }}</div>
        </td><td valign="top" style="padding:12px 14px 12px;border-bottom:1px solid #e8e8e8;">
          <div style="font:bold 10px/14px {{ mono }};letter-spacing:2.5px;text-transform:uppercase;color:#a9a9a9;">Total</div>
          <div class="val fh" style="font:900 24px/30px {{ head }};letter-spacing:.5px;color:#ffffff;">{{ total_price | money_with_currency }}</div>
        </td></tr>
      <tr><td colspan="2" valign="top" style="padding:12px 14px 12px;">
          <div style="font:bold 10px/14px {{ mono }};letter-spacing:2.5px;text-transform:uppercase;color:#a9a9a9;">{% if mode == 'ship' %}Extraction point{% elsif mode == 'pickup' %}Collection point{% else %}Delivery{% endif %}</div>
          <div class="val fh" style="font:900 24px/30px {{ head }};letter-spacing:.5px;text-transform:uppercase;color:#ffffff;">{% if mode == 'ship' %}{{ dest }}{% elsif mode == 'pickup' %}{{ shipping_method.title | default: 'Local pickup' }}{% else %}Nothing to ship{% endif %}</div>
        </td></tr>
      <tr><td colspan="2" style="border-top:1px solid #e8e8e8;padding:8px 14px 7px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
          <td style="font:bold 10px/20px {{ mono }};letter-spacing:1.5px;text-transform:uppercase;color:#a9a9a9;"><span style="white-space:nowrap;">Logged&nbsp;<span style="color:#ececec;">{{ logged_d }}</span></span> &nbsp; <span style="white-space:nowrap;">Locker&nbsp;<span style="color:#ececec;">{{ locker }}</span></span> &nbsp; <span style="white-space:nowrap;"><img src="https://cdn.shopify.com/s/files/1/0691/1252/9150/files/order-email-oc-ladder.png?v=1792625021" width="34" height="14" alt="" style="display:inline-block;vertical-align:-2px;width:34px;height:14px;border:0;">&nbsp;<span style="color:#ececec;">L4</span></span></td>
          <td class="hm" align="right" width="30%" style="width:30%;padding-left:8px;font-size:0;line-height:0;"><img src="https://cdn.shopify.com/s/files/1/0691/1252/9150/files/order-email-oc-barcode-w.png?v=1792625021" width="120" height="17" alt="" style="display:block;margin:0 0 0 auto;width:100%;max-width:120px;height:auto;border:0;"></td>
        </tr></table>
      </td></tr>
    </table>
  </td></tr>

  <!-- the button, with the site's hazard edge (an image, so it keeps its shape if a dark mode repaints the button).
       Outlook ignores padding on the <a>, so the cell carries it there (mso-padding-alt) -->
  <tr><td class="px" style="padding:22px 24px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr><td bgcolor="#0a0a0a" style="background:#0a0a0a;font-size:0;line-height:0;"><img src="https://cdn.shopify.com/s/files/1/0691/1252/9150/files/order-email-oc-hazard.png?v=1792625021" width="520" height="8" alt="" style="display:block;width:100%;max-width:520px;height:auto;border:0;"></td></tr>
      <tr><td align="center" bgcolor="#e8e8e8" style="background:#e8e8e8;border:2px solid #0a0a0a;border-top:0;mso-padding-alt:17px 20px 16px;">
        <a class="btn fh" href="{{ order_status_url }}" target="_blank" style="display:block;padding:17px 20px 16px;font:900 22px/26px {{ head }};letter-spacing:2px;text-transform:uppercase;color:#0a0a0a;text-decoration:none;">View your order&nbsp;&nbsp;&#8599;</a>
      </td></tr>
    </table>
  </td></tr>
  <tr><td class="px" align="center" style="padding:10px 24px 0;font:bold 11px/17px {{ mono }};letter-spacing:1px;text-transform:uppercase;color:#a9a9a9;"><span style="white-space:nowrap;">Live status of {{ order_name }}&nbsp;&middot;</span> <span style="white-space:nowrap;">your order page,</span> <span style="white-space:nowrap;">kept up to date as it moves</span></td></tr>

  <!-- the site's hazard tape -->
  <tr><td style="padding:28px 0 0;font-size:0;line-height:0;"><img src="https://cdn.shopify.com/s/files/1/0691/1252/9150/files/order-email-oc-tape.png?v=1792625021" width="600" height="56" alt="Do not cross // Evidence // Wear the unknown" style="display:block;width:100%;max-width:600px;height:auto;border:0;color:#8a8a8a;font:bold 11px/16px {{ mono }};letter-spacing:3px;text-transform:uppercase;text-align:center;"></td></tr>

