<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#070707">
  <title>{{ shop.name }} — Opening soon</title>
  <meta name="description" content="MONOCHROME® is opening soon. Join the network to hear first.">
  {% render 'mc-fonts' %}
  <script>window.MC = { root: "/", idx: "", page: "password", routes: { home: "/", shop: "/collections/all", cart: "/cart" }, catalogUrl: "/collections/all?view=catalog" }; document.documentElement.classList.add('js');</script>
  {{ 'mc-base.css' | asset_url | stylesheet_tag }}
  {{ 'mc-contact.css' | asset_url | stylesheet_tag }}
  {{ 'mc-customer.css' | asset_url | stylesheet_tag }}
  <link rel="stylesheet" href="{{ 'mc-mobile.css' | asset_url }}" media="(max-width: 899px)">
  {{ content_for_header }}
</head>
<body class="pg-password">
  <main id="main">{{ content_for_layout }}</main>
  <script src="{{ 'mc-core.js' | asset_url }}" defer></script>
</body>
</html>
