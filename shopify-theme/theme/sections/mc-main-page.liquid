{%- liquid
  capture pk
    render 'mc-pagekey'
  endcapture
  assign pkp = pk | split: '~'
  assign folio = pkp[1] | plus: 0
  assign docno = 100 | plus: folio | prepend: 'MC-'
  assign doc = page.title | default: 'Document'
-%}
<section class="spread paper ct-open" aria-labelledby="pageH">
  <div class="wrap">
    {%- if page != blank -%}
      {% render 'mc-filehead', file: docno, doc: page.title, page: folio, level: 1 %}
      <header class="reg-head"><div class="reg-title"><p class="kick mono">Document</p><h1 class="h1" id="pageH">{{ page.title | escape }}</h1></div></header>
      <div class="pg-body rte">{{ page.content }}</div>
    {%- else -%}
      <div class="pg-body rte shopify-policy__container">{{ content_for_layout | default: '' }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [],
  "presets": [{ "name": "Page" }]
}
{% endschema %}
