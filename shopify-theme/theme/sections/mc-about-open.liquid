<!-- 04 MISSION BRIEFING ------------------------------------------------------------------- -->
<section class="spread paper ab-open" aria-labelledby="aboutH">
  <div class="wrap">
    {% render 'mc-filehead', file: 'MC-104', doc: 'Mission and rules of engagement', page: 4, level: 5 %}
    <div class="ab-top">
      <div class="ab-head">
        <p class="kick mono">Division of Wearables — Operation: Wear the Unknown</p>
        <h1 class="h1" id="aboutH"><span class="tw" style="--n:7;--dl:.1s">Mission</span> <span class="tw caret" style="--n:8;--dl:.6s">briefing</span></h1>
        <p class="memo mono">
          <span><b>To:</b> Operative (that is you)</span>
          <span><b>From:</b> Division of Wearables</span>
          <span><b>Re:</b> Black, white and chrome</span>
          <span><b>Date:</b> <span class="redact" tabindex="0">Whenever you read this</span></span>
        </p>
      </div>
      <div class="ab-eq rv" role="img" aria-label="Black plus white plus chrome">
        <span class="eq eq-b" aria-hidden="true">Black</span><i aria-hidden="true">+</i><span class="eq eq-w" aria-hidden="true">White</span><i aria-hidden="true">+</i><span class="eq eq-c" aria-hidden="true">Chrome</span>
      </div>
    </div>
    <p class="ab-deck rv">{{ section.settings.deck | escape }}</p>
    <span class="stamp ts lg ab-stamp" style="--r:-8deg" aria-hidden="true">Top secret</span>
  </div>
</section>

{% schema %}
{
  "name": "About: opening",
  "settings": [
    { "type": "textarea", "id": "deck", "label": "Intro line", "default": "Three finishes, a short list of rules, and the habit of leaving everything else out." }
  ],
  "presets": [{ "name": "About: opening" }]
}
{% endschema %}
