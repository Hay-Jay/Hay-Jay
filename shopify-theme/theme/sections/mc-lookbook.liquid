{%- liquid
  assign letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
  assign n = section.blocks.size
  assign last_i = n | minus: 1
  assign last = letters | slice: last_i, 1
-%}
<!-- EVIDENCE: the surveillance wall, as its own page ---------------------------------------- -->
<section class="spread dark lookbook" id="lookbook" aria-label="Evidence wall">
  <div class="lb-pin" id="lbPin">
    <div class="lb-run mono" aria-hidden="true"><span>File MC-103 — Surveillance exhibits</span><span><b class="rec"></b>Rec</span><span>Page 3 of 7</span></div>
    <div class="lb-track" id="lbTrack" role="region" aria-label="Evidence photographs, scroll sideways" tabindex="0">
      <div class="lb-intro">
        <h1 aria-label="Evidence"><span aria-hidden="true">Evi-</span><span aria-hidden="true">dence</span></h1>
        <p class="mono">{{ n }} exhibits, A to {{ last }}, from the field. <span class="lb-how">Swipe sideways.</span> Open an exhibit to read the asset file.</p>
        <span class="stamp white" style="--r:-6deg" aria-hidden="true">Eyes only</span>
      </div>
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          {%- liquid
            assign li = forloop.index0
            assign ltr = letters | slice: li, 1
            assign pn = block.settings.photo | minus: 1
            assign pic = p.images[pn] | default: p.featured_image
            assign tilt = li | times: 5 | modulo: 7 | minus: 3 | times: 0.35 | round: 2
            assign k = block.settings.scale | divided_by: 100.0
            capture pt
              render 'mc-price', product: p
            endcapture
            assign cam_n = li | plus: 2
            assign ex = 'Exhibit ' | append: ltr
          -%}
          <a class="lb-fig" href="{{ p.url }}" style="--k:{{ k }};--ar:{{ block.settings.ratio }};--mt:{{ block.settings.offset }}vh;--tilt:{{ tilt }}deg" aria-label="Exhibit {{ ltr }}, {{ p.title | strip | escape }}, {{ pt | escape }} CAD. Open the asset dossier" {{ block.shopify_attributes }}>
            <span class="lb-pin-dot" aria-hidden="true"></span>
            <span class="lb-no" aria-hidden="true">{{ ltr }}</span>
            <div class="xp">{% render 'mc-img', image: pic, alt: p.title, sizes: '(min-width:900px) 50vh, 70vw', widths: '480,720,1000,1400', eager: forloop.first %}{% render 'mc-cam', n: cam_n, ex: ex %}</div>
            <span class="lb-cap mono" aria-hidden="true"><b>Exhibit {{ ltr }}</b><span>{{ p.title | strip | escape }}</span><span>{{ pt }}</span></span>
          </a>
        {%- endif -%}
      {%- endfor -%}
      <div class="lb-out"><span class="mono">End of the evidence file</span><a href="{{ routes.all_products_collection_url }}">Asset<br>register<span class="arr" aria-hidden="true"></span></a></div>
    </div>
    <div class="lb-meter mono">
      <span id="lbNo" aria-hidden="true">Exhibit A / {{ last }}</span>
      <span class="lb-rail" aria-hidden="true"><i id="lbBar"></i></span>
      <span class="lb-ctrl">
        <button type="button" id="lbPrev" aria-label="Previous exhibit" hidden>&larr;</button>
        <button type="button" id="lbNext" aria-label="Next exhibit" hidden>&rarr;</button>
      </span>
      <span id="lbHint" aria-hidden="true">Swipe</span>
    </div>
  </div>
</section>
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "ImageGallery", "name": "MONOCHROME® Evidence: surveillance exhibits", "url": {{ shop.url | append: '/pages/lookbook' | json }} }
</script>

{% schema %}
{
  "name": "Evidence wall (lookbook)",
  "settings": [],
  "blocks": [
    {
      "type": "exhibit", "name": "Exhibit", "limit": 26,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "photo", "label": "Photo number", "min": 1, "max": 12, "step": 1, "default": 1 },
        { "type": "select", "id": "ratio", "label": "Frame shape", "options": [{ "value": "4/5", "label": "Portrait 4:5" }, { "value": "3/4", "label": "Portrait 3:4" }, { "value": "1/1", "label": "Square" }, { "value": "4/3", "label": "Landscape 4:3" }, { "value": "3/2", "label": "Landscape 3:2" }], "default": "4/5" },
        { "type": "range", "id": "scale", "label": "Size (%)", "min": 50, "max": 100, "step": 2, "default": 100 },
        { "type": "range", "id": "offset", "label": "Vertical offset", "min": -10, "max": 10, "step": 1, "default": 0, "unit": "vh" }
      ]
    }
  ],
  "presets": [{ "name": "Evidence wall (lookbook)" }]
}
{% endschema %}
