<section class="spread dark pw" aria-labelledby="pwH">
  <div class="wrap pw-wrap">
    <img class="pw-emblem" src="{{ 'mc-emblem.webp' | asset_url }}" alt="" width="96" height="103">
    <img class="pw-word" src="{{ 'mc-wordmark.webp' | asset_url }}" alt="MONOCHROME" width="1170" height="114">
    <p class="kick mono">Clearance pending — doors closed</p>
    <h1 class="h1" id="pwH"><span class="tw" style="--n:7;--dl:.1s">Opening</span> <span class="tw caret" style="--n:4;--dl:.6s">soon</span></h1>
    <p class="pw-copy">{{ section.settings.text | escape }}</p>
    <div class="enlist pw-news">
      {% render 'mc-newsletter', id: 'pw-news', submit: 'Join the network' %}
    </div>
    {%- if section.settings.rsvp_label != blank -%}
      <p><a class="btn ghost" href="{{ section.settings.rsvp_url }}" target="_blank" rel="noopener">{{ section.settings.rsvp_label | escape }}<i class="arr" aria-hidden="true"></i></a></p>
    {%- endif -%}
    <details class="pw-enter">
      <summary class="mono">Enter using password</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <label class="mono" for="PwInput">Password</label>
        <div class="news-row"><input type="password" name="password" id="PwInput" autocomplete="current-password" required><button class="send" type="submit">Enter<span class="arr" aria-hidden="true"></span></button></div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Opening soon",
  "settings": [
    { "type": "textarea", "id": "text", "label": "Text", "default": "Be the first to know when we launch." },
    { "type": "text", "id": "rsvp_label", "label": "Event button", "default": "R.S.V.P for our exclusive launch event" },
    { "type": "url", "id": "rsvp_url", "label": "Event link", "default": "https://www.eventbrite.ca/e/monochrome-launch-event-tickets-915069827487" }
  ]
}
{% endschema %}
