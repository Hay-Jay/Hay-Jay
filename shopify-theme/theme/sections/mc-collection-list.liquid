<section class="spread paper reg" aria-labelledby="listH">
  <div class="wrap">
    {% render 'mc-filehead', file: 'MC-102', doc: 'Asset sections', page: 2, level: 3 %}
    <header class="reg-head"><div class="reg-title"><p class="kick mono">Division of Wearables</p><h1 class="h1" id="listH">Collections</h1></div></header>
    <ol class="toc" style="display:block">
      {%- for c in collections -%}
        <li class="trow"><a class="trow-a" href="{{ c.url }}"><span class="t-no mono">{{ forloop.index | prepend: '00' | slice: -2, 2 }}</span><span class="t-name">{{ c.title | escape }}</span><span class="t-meta mono"><span class="t-cat">{{ c.products_count }} assets</span></span><span class="t-price mono">Open<small></small></span></a></li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{ "name": "Collection list", "settings": [] }
{% endschema %}
