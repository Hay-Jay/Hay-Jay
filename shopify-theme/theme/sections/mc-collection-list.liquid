<section class="spread paper shop" aria-labelledby="listH">
  <div class="wrap">
    <header class="sh-head">
      <p class="sh-file mono"><span class="sh-no">MC-102</span><span>{{ section.settings.kicker | escape }}</span></p>
      <h1 class="h1 sh-h" id="listH"><span class="tw caret" style="--n:{{ section.settings.heading.size }}">{{ section.settings.heading | escape }}</span></h1>
    </header>
    <div class="sh-grid cl-grid">
      {%- for c in collections -%}
        {%- if c.products_count > 0 -%}
          {%- assign pic = c.image | default: c.products.first.featured_image -%}
          <div class="card cl-tile" style="--i:{{ forloop.index0 | at_most: 12 }}">
            <a class="card-a" href="{{ c.url }}">
              <span class="card-ph">
                {%- if pic %}{% render 'mc-img', image: pic, alt: c.title, widths: '360,540,720,960', sizes: '(min-width:1400px) 330px, (min-width:1100px) 24vw, (min-width:700px) 32vw, 48vw', eager: forloop.first %}{% endif -%}
                <i class="card-vf" aria-hidden="true"></i>
                <span class="card-tag" aria-hidden="true">SEC-{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              </span>
              <span class="cap"><b class="card-t">{{ c.title | escape }}</b><span class="card-m"><span class="pr">{{ c.products_count }} {% if c.products_count == 1 %}piece{% else %}pieces{% endif %}</span><span class="sz">Shop<span class="arr" aria-hidden="true"></span></span></span></span>
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "text", "id": "kicker", "label": "Small label above the heading", "default": "Asset sections" }
  ]
}
{% endschema %}
