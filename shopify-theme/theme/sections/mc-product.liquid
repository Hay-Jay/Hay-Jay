{%- liquid
  capture ord
    render 'mc-order'
  endcapture
  assign order_list = ord | split: ','
  capture cls
    render 'mc-class', product: product
  endcapture
  capture fno
    render 'mc-fileno', product: product, order: ord
  endcapture
  capture fnum
    render 'mc-fileno', product: product, order: ord, plain: true
  endcapture
  assign num = fnum | plus: 0
  case cls
    when 'top'
      assign plural = 'Tops'
      assign fit = section.settings.fit_top
    when 'bottom'
      assign plural = 'Bottoms'
      assign fit = section.settings.fit_bottom
    when 'accessory'
      assign plural = 'Hardware'
      assign fit = section.settings.fit_accessory
    when 'gift'
      assign plural = 'Gift cards'
      assign fit = ''
    else
      assign plural = 'Print'
      assign fit = ''
  endcase
  assign colh = product.collections | map: 'handle'
  assign is_new = false
  if colh contains 'new-arrivals'
    assign is_new = true
  endif
  assign cur = product.selected_or_first_available_variant
  assign n_img = product.images.size
  assign product_form_id = 'product-form-' | append: section.id
  assign gal_id = 'gal-' | append: section.id
  assign has_choice = true
  if product.has_only_default_variant
    assign has_choice = false
  endif
  capture raw
    render 'mc-countries'
  endcapture
  assign countries = raw | split: ';'
  assign ship_html = section.settings.ship_text | replace: '{countries}', countries.size

  # the stage takes the shape of the first photograph: portrait 4:5, otherwise square
  assign stage_ar = '1 / 1'
  assign first = product.images.first
  if first and first.aspect_ratio < 0.95
    assign stage_ar = '4 / 5'
  endif

  # the free Vision Issue line: jerseys and hoodies (by type or title) and the magazine itself
  assign offer = false
  if section.settings.offer_on and section.settings.offer_text != blank
    assign ptype = product.type | downcase
    assign ptitle = product.title | downcase
    if ptype contains 'jersey' or ptype contains 'hoodie' or ptitle contains 'jersey' or ptitle contains 'hoodie' or cls == 'print'
      assign offer = true
    endif
  endif

  assign compare = false
  if cur.compare_at_price > cur.price
    assign compare = true
  endif
-%}
<article class="plate-page" data-handle="{{ product.handle }}">
<section class="spread dark pl" id="plate" aria-labelledby="plTitle">
  {%- comment -%} PHOTOS: a swipe strip (scroll snap, so it also swipes without JavaScript), thumbnails, and a zoom view {%- endcomment -%}
  <div class="pl-l">
    <div class="gal{% if n_img < 2 %} gal-one{% endif %}" id="{{ gal_id }}" role="region" aria-roledescription="carousel" aria-label="Photos of {{ product.title | strip | escape }}" style="--sar:{{ stage_ar }}">
      <div class="gal-stage">
        <ol class="gal-track" id="galTrack" tabindex="-1">
          {%- for im in product.images -%}
            <li class="gal-slide" id="{{ gal_id }}-{{ forloop.index }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ n_img }}">
              <a class="xp gal-xp" href="{{ im | image_url: width: 2000 }}" data-i="{{ forloop.index0 }}" aria-label="Zoom photo {{ forloop.index }} of {{ n_img }}">
                {%- render 'mc-img', image: im, alt: product.title, sizes: '(min-width:900px) 54vw, 100vw', widths: '640,960,1280,1800', eager: forloop.first -%}
              </a>
            </li>
          {%- endfor -%}
        </ol>
        {% render 'mc-cam', n: num, ex: fno, live: true %}
        {%- if n_img > 1 -%}
          <button class="gal-nav gal-prev" type="button" aria-label="Previous photo" aria-controls="galTrack"><i aria-hidden="true"></i></button>
          <button class="gal-nav gal-next" type="button" aria-label="Next photo" aria-controls="galTrack"><i aria-hidden="true"></i></button>
        {%- endif -%}
        <span class="gal-count mono" aria-hidden="true"><b id="galCount">01</b> / {{ n_img | prepend: '0' | slice: -2, 2 }}</span>
        <button class="gal-zoom mono" type="button" id="galZoom" aria-label="Zoom photo"><i aria-hidden="true"></i>Zoom</button>
        {%- unless product.available -%}<span class="stamp white gal-oos" style="--r:-9deg" aria-hidden="true">Out of stock</span>{%- endunless -%}
      </div>
      {%- if n_img > 1 -%}
        <div class="gal-thumbs" id="galThumbs" role="group" aria-label="Choose a photo">
          {%- for im in product.images -%}
            <a class="gal-th" href="#{{ gal_id }}-{{ forloop.index }}" data-i="{{ forloop.index0 }}" aria-label="Photo {{ forloop.index }} of {{ n_img }}"{% if forloop.first %} aria-current="true"{% endif %}><img loading="lazy" decoding="async" draggable="false" src="{{ im | image_url: width: 160 }}" width="64" height="80" alt=""></a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} BUY: name, price, sizes, Add to bag; the details fold away {%- endcomment -%}
  <div class="pl-r paper">
    <div class="pl-meta mono">
      <nav class="pl-crumb" aria-label="Breadcrumb"><ol>
        <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
        <li><a href="{{ routes.all_products_collection_url }}?c={{ cls }}">{{ plural }}</a></li>
        <li class="sr-only"><span aria-current="page">{{ product.title | strip | escape }}</span></li>
      </ol></nav>
      <span class="pl-fno">{% if is_new %}<b class="pl-new">New</b>{% endif %}{{ fno }}</span>
    </div>
    <h1 class="pl-title" id="plTitle">{{ product.title | strip | escape }}</h1>
    <div class="pl-priceline">
      <p class="pl-price" id="price">
        <span id="priceV">{%- if product.price_varies and product.selected_variant == blank -%}From {{ product.price | money }}{%- else -%}{{ cur.price | money }}{%- endif -%}</span>
        <small>{{ cart.currency.iso_code }}</small>
        <s class="pl-was" id="priceWas"{% unless compare %} hidden{% endunless %}>{{ cur.compare_at_price | money }}</s>
      </p>
      <p class="pl-stock mono {% if cur.available %}in{% else %}out{% endif %}" id="stock"><i aria-hidden="true"></i><span>{% if cur.available %}In stock{% else %}Sold out{% endif %}</span></p>
    </div>
    {%- if offer -%}
      <p class="pl-offer mono"><i aria-hidden="true">+</i><span>{{ section.settings.offer_text | escape }}</span></p>
    {%- endif -%}

    {%- form 'product', product, id: product_form_id, class: 'pl-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
      <input type="hidden" name="id" value="{{ cur.id }}" id="variantId">
      {%- if has_choice -%}
        <noscript>
          <label class="opt-name" for="variantSel">Choose</label>
          <select name="id" id="variantSel" class="pl-select">
            {%- for v in product.variants -%}<option value="{{ v.id }}"{% if v == cur %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title | escape }} — {{ v.price | money }}{% unless v.available %} (sold out){% endunless %}</option>{%- endfor -%}
          </select>
        </noscript>
        <div class="pl-opts" id="opts">
          {%- for opt in product.options_with_values -%}
            {%- assign oi = forloop.index0 -%}
            {%- if opt.values.size > 1 -%}
              <fieldset class="opt" data-o="{{ oi }}">
                <legend class="opt-name">{{ opt.name | escape }}<b>{{ cur.options[oi] | escape }}</b></legend>
                <div class="chips">
                  {%- for val in opt.values -%}
                    {%- assign val_ok = false -%}
                    {%- for v in product.variants -%}
                      {%- if v.available and v.options[oi] == val -%}{%- assign val_ok = true -%}{%- endif -%}
                    {%- endfor -%}
                    <button type="button" class="chip{% if cur.options[oi] == val %} on{% endif %}" data-o="{{ oi }}" data-v="{{ val | escape }}" aria-pressed="{% if cur.options[oi] == val %}true{% else %}false{% endif %}"{% unless val_ok %} disabled aria-label="{{ val | escape }}, sold out"{% endunless %}>{{ val | escape }}</button>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- comment -%} app blocks: Easify personalisation and Klarna messaging sit just above the button {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="pl-app" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endcase -%}
      {%- endfor -%}
      <div class="pl-buy" id="plBuy">
        <div class="qty pl-qty" data-pqty>
          <button type="button" data-pq="-1" aria-label="Fewer">−</button>
          <input type="number" id="qty-{{ section.id }}" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
          <button type="button" data-pq="1" aria-label="More">+</button>
        </div>
        {%- if cur.available -%}
          <button class="buy" id="buy" type="submit" name="add"><span id="buyT">Add to bag</span><i class="buy-bag" aria-hidden="true"></i></button>
        {%- else -%}
          <button class="buy" id="buy" type="submit" name="add" disabled aria-disabled="true"><span id="buyT">Sold out</span><i class="buy-bag" aria-hidden="true"></i></button>
        {%- endif -%}
        <p class="pl-err cart-err mono" role="alert" hidden></p>
      </div>
      {%- if section.settings.show_dynamic and settings.cart_dynamic_buttons and cur.available -%}
        <div class="pl-pay">{{ form | payment_button }}</div>
      {%- endif -%}
      <a class="mono pl-alert" id="alertLink" href="{{ section.settings.alert_url | default: '/pages/contact#subscribe' }}"{% if cur.available %} hidden{% endif %}>Get restock alerts<span class="arr" aria-hidden="true"></span></a>
    {%- endform -%}

    <div class="pl-dets">
      {%- if product.description != blank -%}
        <details class="pl-det">
          <summary>Description<i aria-hidden="true"></i></summary>
          <div class="pl-det-b rte">{{ product.description }}</div>
        </details>
      {%- endif -%}
      {%- if has_choice and fit != blank -%}
        <details class="pl-det">
          <summary>Size and fit<i aria-hidden="true"></i></summary>
          <div class="pl-det-b rte">{{ fit }}</div>
        </details>
      {%- endif -%}
      <details class="pl-det">
        <summary>Shipping<i aria-hidden="true"></i></summary>
        <div class="pl-det-b rte">
          {{ ship_html }}
          <p><a class="link-line" href="{{ section.settings.ship_url | default: '/pages/shipping' }}">Shipping &amp; returns</a></p>
        </div>
      </details>
    </div>
    <div class="pl-foot" aria-hidden="true">{% render 'mc-barcode', seed: num, w: 220, h: 40 %}<span class="mono">{{ fno }} // {{ plural }}</span></div>
  </div>
</section>

{%- liquid
  # related: the same kind first, then everything else in stock, then sold out
  assign everything = collections['all'].products
  assign rel_same_av = ''
  assign rel_other_av = ''
  assign rel_sold = ''
  for h in order_list
    if h != product.handle
      assign q = everything | where: 'handle', h | first
      if q
        capture qc
          render 'mc-class', product: q
        endcapture
        if q.available
          if qc == cls
            assign rel_same_av = rel_same_av | append: h | append: ','
          else
            assign rel_other_av = rel_other_av | append: h | append: ','
          endif
        else
          assign rel_sold = rel_sold | append: h | append: ','
        endif
      endif
    endif
  endfor
  assign rel_all = rel_same_av | append: rel_other_av | append: rel_sold | remove_last: ','
  assign rel_list = rel_all | split: ','
  assign rel_n = section.settings.rel_count
-%}
{%- if rel_n > 0 and rel_list.size > 0 -%}
<section class="spread paper rel" aria-labelledby="relH">
  <div class="wrap">
    <header class="rel-h">
      <h2 class="h2" id="relH">{{ section.settings.rel_title | escape }}</h2>
      <a class="mono link-line" href="{{ routes.all_products_collection_url }}">Shop all<span class="arr" aria-hidden="true"></span></a>
    </header>
    <div class="rel-row">
      {%- for h in rel_list limit: rel_n -%}
        {%- assign q = everything | where: 'handle', h | first -%}
        {% render 'mc-card', product: q, i: forloop.index0, order: ord, sizes: '(min-width:900px) 23vw, 46vw' %}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{%- if product.available -%}
  {%- comment -%} phones: Add to bag stays under the thumb once the main button has scrolled away (mc-product.js shows it) {%- endcomment -%}
  <div class="pl-sticky" id="plSticky" inert>
    {%- if first -%}<span class="pls-ph" aria-hidden="true"><img src="{{ first | image_url: width: 120 }}" width="40" height="50" alt="" loading="lazy" decoding="async"></span>{%- endif -%}
    <span class="pls-t"><b>{{ product.title | strip | escape }}</b><span class="mono" id="plsMeta">
      {%- assign meta = '' -%}
      {%- for opt in product.options_with_values -%}
        {%- if opt.values.size > 1 -%}{%- assign meta = meta | append: cur.options[forloop.index0] | append: ' / ' -%}{%- endif -%}
      {%- endfor -%}
      {%- assign meta = meta | remove_last: ' / ' -%}
      {%- assign cur_m = cur.price | money -%}
      {%- if meta != blank and meta != cur_m %}{{ meta | escape }} · {% endif %}{{ cur_m -}}
    </span></span>
    <button class="pls-go" id="plsBuy" type="submit" form="{{ product_form_id }}" name="add"{% unless cur.available %} disabled{% endunless %}>{% if cur.available %}Add to bag{% else %}Sold out{% endif %}</button>
  </div>
  <div class="pl-sticky-room" aria-hidden="true"></div>
{%- endif -%}
</article>

{%- comment -%} the zoom view: full screen, true colour ("declassified"); mc-product.js opens it {%- endcomment -%}
<div class="lb" id="plLb" role="dialog" aria-modal="true" aria-label="Photos of {{ product.title | strip | escape }}" hidden>
  <div class="lb-top">
    <p class="mono lb-k"><b class="rec" aria-hidden="true"></b>Declassified <span id="lbCount">01 / {{ n_img }}</span></p>
    <button class="lb-x" type="button" data-lb-close aria-label="Close photos"><i aria-hidden="true"></i></button>
  </div>
  <div class="lb-stage" id="lbStage"><img class="lb-img" id="lbImg" alt="{{ product.title | strip | escape }}" draggable="false" width="{{ first.width | default: 1000 }}" height="{{ first.height | default: 1250 }}"></div>
  {%- if n_img > 1 -%}
    <button class="gal-nav lb-prev" type="button" data-lb="-1" aria-label="Previous photo"><i aria-hidden="true"></i></button>
    <button class="gal-nav lb-next" type="button" data-lb="1" aria-label="Next photo"><i aria-hidden="true"></i></button>
  {%- endif -%}
  <p class="mono lb-hint" aria-hidden="true"><span class="hint-fine">Click to zoom</span><span class="hint-touch">Tap to zoom</span></p>
</div>

{%- comment -%} data for mc-product.js {%- endcomment -%}
<script type="application/json" id="pdata">
{
  "h": {{ product.handle | json }},
  "form": {{ product_form_id | json }},
  "range": {{ product.price_varies | json }},
  "from": {{ product.price | money | json }},
  "cur": {{ cart.currency.iso_code | json }},
  "chosen": {% if product.selected_variant != blank %}true{% else %}false{% endif %},
  "options": [{% for opt in product.options_with_values %}{ "name": {{ opt.name | json }}, "values": {{ opt.values | json }} }{% unless forloop.last %},{% endunless %}{% endfor %}],
  "variants": [{% for v in product.variants %}{ "id": {{ v.id }}, "o": {{ v.options | json }}, "m": {{ v.price | money | json }}, "c": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}""{% endif %}, "a": {% if v.available %}1{% else %}0{% endif %}, "i": {% if v.featured_image %}{{ v.featured_image.position | minus: 1 }}{% else %}-1{% endif %} }{% unless forloop.last %},{% endunless %}{% endfor %}],
  "sel": {{ cur.options | json }}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org", "@type": "Product",
  "name": {{ product.title | strip | json }},
  "description": {{ product.description | strip_html | strip_newlines | truncate: 300 | json }},
  "sku": {{ cur.sku | default: product.handle | json }},
  "category": {{ plural | json }},
  "brand": { "@type": "Brand", "name": "MONOCHROME" },
  "url": {{ canonical_url | json }},
  "image": [{% for im in product.images limit: 6 %}{{ im | image_url: width: 1200 | prepend: 'https:' | replace: 'https:https:', 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
  "offers": [{% for v in product.variants %}{ "@type": "Offer", "url": {{ canonical_url | append: '?variant=' | append: v.id | json }}, "price": {{ v.price | divided_by: 100.0 | json }}, "priceCurrency": {{ cart.currency.iso_code | json }}, "availability": "{% if v.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}", "itemCondition": "https://schema.org/NewCondition", "sku": {{ v.sku | default: v.id | json }}, "name": {{ v.title | json }} }{% unless forloop.last %},{% endunless %}{% endfor %}]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }} },
    { "@type": "ListItem", "position": 2, "name": "Shop", "item": {{ shop.url | append: routes.all_products_collection_url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ plural | json }}, "item": {{ shop.url | append: routes.all_products_collection_url | append: '?c=' | append: cls | json }} },
    { "@type": "ListItem", "position": 4, "name": {{ product.title | strip | json }}, "item": {{ canonical_url | json }} }
  ]
}
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic", "label": "Show accelerated checkout buttons (Shop Pay, PayPal...)", "default": true },
    { "type": "url", "id": "alert_url", "label": "Restock alerts link (sold out products)" },
    { "type": "header", "content": "Free Vision Issue offer" },
    { "type": "checkbox", "id": "offer_on", "label": "Show the offer line on jerseys, hoodies and the magazine", "info": "Turn off when the automatic discount ends.", "default": true },
    { "type": "text", "id": "offer_text", "label": "Offer line", "default": "Free Vision Issue with any jersey or hoodie. Applied at checkout." },
    { "type": "header", "content": "Details" },
    { "type": "richtext", "id": "fit_top", "label": "Size and fit: tops", "default": "<p>Relaxed cut, true to size. Between sizes? Go up.</p>" },
    { "type": "richtext", "id": "fit_bottom", "label": "Size and fit: bottoms", "default": "<p>Not sure of your size? Message us before you order.</p>" },
    { "type": "richtext", "id": "fit_accessory", "label": "Size and fit: hardware", "default": "<p>Rings: between two sizes, go up. Chains and necklaces: one size.</p>" },
    { "type": "richtext", "id": "ship_text", "label": "Shipping", "info": "{countries} = number of countries in the shipping list", "default": "<p>Ships to {countries} countries, Nigeria and Canada included. Rates are calculated at checkout.</p>" },
    { "type": "url", "id": "ship_url", "label": "Shipping & returns link" },
    { "type": "header", "content": "Related products" },
    { "type": "text", "id": "rel_title", "label": "Heading", "default": "Also on file" },
    { "type": "range", "id": "rel_count", "label": "Number of products", "min": 0, "max": 8, "step": 1, "default": 4 }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}
