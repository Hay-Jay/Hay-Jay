<section class="spread paper cu" aria-labelledby="cuH">
  <div class="wrap cu-wrap">
    <header class="pg-head">
      <p class="pg-file mono"><span class="pg-no">MC-109</span><span>Account</span></p>
      <h1 class="h1 pg-h" id="cuH">Activate</h1>
    </header>
    {%- form 'activate_customer_password', class: 'cu-form news' -%}
      {%- if form.errors -%}<p class="mono news-note" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label class="mono" for="AcP">Password</label><input type="password" name="customer[password]" id="AcP" autocomplete="new-password" required>
      <label class="mono" for="AcC">Confirm password</label><input type="password" name="customer[password_confirmation]" id="AcC" autocomplete="new-password" required>
      <button class="send" type="submit">Activate<span class="arr" aria-hidden="true"></span></button>
      <button class="btn ghost" type="submit" name="decline">Decline the invitation</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Activate account", "settings": [] }
{% endschema %}
