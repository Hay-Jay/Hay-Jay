{%- assign fb = section.settings.figure_b -%}
<!-- RULES: one line each -->
<section class="spread dark ab-roe" aria-labelledby="roeH">
  <div class="wrap roe-grid">
    <div class="roe-main">
      <p class="pg-file mono"><span class="pg-no">{{ section.blocks.size | prepend: '0' | slice: -2, 2 }}</span><span>Rules of engagement</span></p>
      <h2 class="ab-h2 rv" id="roeH">{{ section.settings.heading | escape }}</h2>
      <ol class="rules">
        {%- for block in section.blocks -%}
          <li class="rv" style="--rv:{{ forloop.index0 }}" {{ block.shopify_attributes }}><span class="r-n mono" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span><b>{{ block.settings.title | escape }}</b>{% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}</li>
        {%- endfor -%}
      </ol>
    </div>
    {%- if fb != blank -%}
      {%- assign pn = section.settings.figure_b_photo | minus: 1 -%}
      {%- assign pic = fb.images[pn] | default: fb.featured_image -%}
      <figure class="ab-fig ab-fig-b rv" data-tilt>
        <span class="tape" aria-hidden="true"></span>
        <a class="xp zoom" href="{{ fb.url }}">{% render 'mc-img', image: pic, alt: fb.title, sizes: '(min-width:960px) 380px, 80vw', widths: '400,600,900' %}<span class="ab-ex mono" aria-hidden="true">Exhibit B</span></a>
        <figcaption class="mono"><a href="{{ fb.url }}">{{ fb.title | strip | escape }}</a><span>{% render 'mc-price', product: fb %}</span></figcaption>
      </figure>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About: rules",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The rules" },
    { "type": "product", "id": "figure_b", "label": "Exhibit B product" },
    { "type": "range", "id": "figure_b_photo", "label": "Exhibit B photo number", "min": 1, "max": 12, "step": 1, "default": 1 }
  ],
  "blocks": [
    {
      "type": "rule", "name": "Rule", "limit": 10,
      "settings": [
        { "type": "text", "id": "title", "label": "Rule", "default": "No colour of the month." },
        { "type": "textarea", "id": "text", "label": "Small print", "info": "Optional. Keep it to one line." }
      ]
    }
  ],
  "presets": [{ "name": "About: rules" }]
}
{% endschema %}
