<section class="spread paper cu" aria-labelledby="cuH">
  <div class="wrap cu-wrap">
    {% render 'mc-filehead', file: 'MC-109', doc: 'Operative login', page: 7, level: 2 %}
    <h1 class="h1" id="cuH">Sign in</h1>
    {%- form 'customer_login', novalidate: 'novalidate', class: 'cu-form news' -%}
      {%- if form.errors -%}<p class="mono news-note" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label class="mono" for="CuEmail">Email</label>
      <input type="email" name="customer[email]" id="CuEmail" autocomplete="email" required>
      {%- if form.password_needed -%}
        <label class="mono" for="CuPass">Password</label>
        <input type="password" name="customer[password]" id="CuPass" autocomplete="current-password" required>
        <a class="mono link-line" href="#recover">Forgot your password?</a>
      {%- endif -%}
      <button class="send" type="submit">Sign in<span class="arr" aria-hidden="true"></span></button>
    {%- endform -%}
    <div id="recover" class="cu-recover">
      <h2 class="h2">Reset your password</h2>
      {%- form 'recover_customer_password', class: 'cu-form news' -%}
        {%- if form.posted_successfully? -%}<p class="mono news-note" role="status">We have sent you an email with a link to reset your password.</p>{%- endif -%}
        <label class="mono" for="RecEmail">Email</label>
        <input type="email" name="email" id="RecEmail" autocomplete="email" required>
        <button class="send" type="submit">Send the link<span class="arr" aria-hidden="true"></span></button>
      {%- endform -%}
    </div>
    <p class="mono">New here? <a class="link-line" href="{{ routes.account_register_url }}">Create an account</a></p>
  </div>
</section>
{% schema %}
{ "name": "Sign in", "settings": [] }
{% endschema %}
