<!-- 06 JOIN THE NETWORK ------------------------------------------------------------------- -->
<section class="spread paper subscribe" id="subscribe" aria-labelledby="subH">
  <div class="wrap">
    <div class="enlist">
      <span class="tape tape-l" aria-hidden="true"></span><span class="tape tape-r" aria-hidden="true"></span>
      <div class="enl-head">
        <p class="kick mono">{{ section.settings.kicker | escape }}</p>
        <h2 class="h2" id="subH">{{ section.settings.heading | escape }}</h2>
        <p class="sec-sub">{{ section.settings.sub | escape }}</p>
      </div>
      {% render 'mc-newsletter', id: 'home-news', note: section.settings.note %}
      <span class="stamp pend" style="--r:-6deg" aria-hidden="true">Clearance pending</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Join the network (signup)",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "§5 — Recruitment form" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the network" },
    { "type": "textarea", "id": "sub", "label": "Intro", "default": "Get drop alerts first. One email, your address, no field work required." },
    { "type": "text", "id": "note", "label": "Small print", "default": "One email when a drop is cleared. No field work required." }
  ],
  "presets": [{ "name": "Join the network (signup)" }]
}
{% endschema %}
