{%- comment -%}
  Home product grid: the first products of a collection chosen in the theme editor (default: the owner's "Home page" collection,
  handle frontpage), as product cards (snippets/mc-card: photo first, second photo on hover, quick add). 2 columns on phones, 4 from 900px.
{%- endcomment -%}
{%- assign tk_pieces = '{pieces}' -%}
{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections['frontpage']
  endif
  if col == blank or col.products_count == 0
    assign col = collections['all']
  endif
  assign limit = section.settings.count | default: 8
  capture ord
    render 'mc-order'
  endcapture
  assign n_pieces = collections['all'].products_count
  assign all_label = section.settings.link_text | replace: tk_pieces, n_pieces
  assign link = section.settings.link_url | default: routes.all_products_collection_url
-%}
<section class="spread dark hgrid" id="assets" aria-labelledby="gridH">
  <div class="wrap">
    <header class="hsec-h">
      <div>
        {%- if section.settings.kicker != blank %}<p class="kick mono">{{ section.settings.kicker | escape }}</p>{% endif -%}
        <h2 class="h2 rv" id="gridH">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if all_label != blank %}<a class="btn-line mono hsec-more" href="{{ link }}">{{ all_label | escape }}<span class="arr" aria-hidden="true"></span></a>{% endif -%}
    </header>
    <div class="hg-grid">
      {%- assign shown = 0 -%}
      {%- for p in col.products -%}
        {%- if shown >= limit %}{% break %}{% endif -%}
        {%- if section.settings.hide_sold and p.available == false %}{% continue %}{% endif -%}
        {% render 'mc-card', product: p, i: shown, order: ord, sizes: '(min-width:1400px) 310px, (min-width:700px) 23vw, 46vw', widths: '300,450,600,800' %}
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
    </div>
    {%- if all_label != blank %}<p class="hg-end"><a class="btn ghost" href="{{ link }}">{{ all_label | escape }}<i class="arr" aria-hidden="true"></i></a></p>{% endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Empty: the Home page collection (frontpage), or all products." },
    { "type": "range", "id": "count", "label": "Products shown", "min": 2, "max": 16, "step": 2, "default": 8 },
    { "type": "checkbox", "id": "hide_sold", "label": "Skip sold-out products", "default": true },
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "§1 / Cleared for wear" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The drop" },
    { "type": "text", "id": "link_text", "label": "Link text ({pieces} = live count)", "default": "Shop all {pieces}" },
    { "type": "url", "id": "link_url", "label": "Link", "info": "Empty: all products." }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
