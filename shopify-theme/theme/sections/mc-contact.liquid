{%- liquid
  capture raw
    render 'mc-countries'
  endcapture
  assign countries = raw | split: ';'
  assign n_pieces = collections['all'].products_count
  assign title = section.settings.heading
  if page != blank and page.handle != 'contact'
    assign title = page.title
  endif
  assign tw = title | split: ' '
  assign is_contact = true
  if page != blank and page.handle != 'contact'
    assign is_contact = false
  endif
-%}
<!-- 07 REPORT IN ------------------------------------------------------------------------------ -->
<section class="spread dark ct-open" aria-labelledby="colH">
  <div class="wrap">
    <div class="filehead-wrap">{% render 'mc-filehead', file: 'MC-107', doc: 'Secure channel', page: 7, level: 1 %}</div>
    <div class="ct-grid">
      <div class="ct-term">
        <p class="kick mono">Secure channel — standing by</p>
        {%- comment -%} one typing span per word, so long page titles ("Model signup form") wrap instead of running into the lines {%- endcomment -%}
        <h1 class="h1" id="colH">{% for w in tw %}<span class="tw{% if forloop.last %} caret{% endif %}" style="--n:{{ w | size }};--dl:{{ forloop.index0 | times: 0.45 | plus: 0.1 }}s">{{ w | escape }}</span>{% unless forloop.last %} {% endunless %}{% endfor %}</h1>
        <pre class="term" aria-hidden="true">&gt; OPENING CHANNEL ........ OK
&gt; OPERATIVE .............. YOU
&gt; STATUS ................. STANDING BY
&gt; AWAITING YOUR MESSAGE_</pre>
        {%- if page != blank and page.content != blank -%}
          <div class="co-deck rte">{{ page.content }}</div>
        {%- else -%}
          <p class="co-deck">{{ section.settings.deck | escape }}</p>
        {%- endif -%}
      </div>
      <div class="ct-lines">
        <ul class="cn-links">
          <li><a href="mailto:{{ settings.contact_email }}"><span class="mono">Line 1 — Email</span><b>{{ settings.contact_email | replace: '@', '<wbr>@' }}</b><i class="arr" aria-hidden="true"></i></a></li>
          {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener"><span class="mono">Line 2 — Instagram</span><b>@monochrome.ca</b><i class="arr" aria-hidden="true"></i></a></li>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener"><span class="mono">Line 3 — TikTok</span><b>@monochrome.ca</b><i class="arr" aria-hidden="true"></i></a></li>{%- endif -%}
          {%- if settings.social_snapchat != blank -%}<li><a href="{{ settings.social_snapchat }}" target="_blank" rel="noopener"><span class="mono">Line 4 — Snapchat</span><b>monochrome.ca</b><i class="arr" aria-hidden="true"></i></a></li>{%- endif -%}
          <li><a href="{{ routes.root_url }}"><span class="mono">Line 5 — The store</span><b>{{ shop.domain }}</b><i class="arr" aria-hidden="true"></i></a></li>
        </ul>
        <div class="ct-seal" aria-hidden="true"><span class="stamp white lg" style="--r:-7deg">Line open</span></div>
      </div>
    </div>
  </div>
</section>

<section class="spread paper ct-form-sec" id="message" aria-labelledby="msgH">
  <div class="wrap">
    <div class="enlist ct-msg">
      <span class="tape tape-l" aria-hidden="true"></span><span class="tape tape-r" aria-hidden="true"></span>
      <div class="enl-head">
        <p class="kick mono">Message form</p>
        <h2 class="h2" id="msgH">{% if is_contact %}{{ section.settings.form_heading | escape }}{% else %}{{ page.title | escape }}{% endif %}</h2>
      </div>
      {%- form 'contact', id: 'contactForm', class: 'news ct-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="ct-ok" role="status"><b>Message received.</b> We will answer from the Bureau as soon as we can.</p>
        {%- else -%}
          {%- if form.errors -%}<p class="mono news-note" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
          <div class="ct-fields">
            <label class="ct-f"><span class="mono">Your name</span><input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></label>
            <label class="ct-f"><span class="mono">Email address</span><input type="email" name="contact[email]" required autocomplete="email" placeholder="you@email.com" value="{{ form.email }}"></label>
            {%- unless is_contact -%}
              <label class="ct-f"><span class="mono">Phone number</span><input type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></label>
            {%- endunless -%}
            <label class="ct-f ct-f-wide"><span class="mono">Message</span><textarea name="contact[body]" rows="5" required>{{ form.body }}</textarea></label>
          </div>
          <button class="send" type="submit">Send the message<span class="arr" aria-hidden="true"></span></button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

<section class="spread paper ct-file" id="subscribe" aria-labelledby="subH">
  <div class="wrap ct-file-grid">
    <div class="ct-dossier">
      <p class="kick mono">Bureau particulars</p>
      <dl class="co-list">
        <div><dt class="mono">Bureau</dt><dd>MONOCHROME®</dd></div>
        <div><dt class="mono">Division</dt><dd>Wearables</dd></div>
        <div><dt class="mono">Operation</dt><dd>Wear the Unknown</dd></div>
        <div><dt class="mono">Finishes</dt><dd>Black, white and chrome</dd></div>
        <div><dt class="mono">Assets</dt><dd>{{ n_pieces }}, in small runs</dd></div>
        <div><dt class="mono">Photographs</dt><dd>The Monochrome archive</dd></div>
        <div><dt class="mono">Set in</dt><dd>Big Shoulders, Special Elite, Courier Prime &amp; Stardos Stencil</dd></div>
        <div><dt class="mono">Headquarters</dt><dd>{{ section.settings.hq | escape }}</dd></div>
        <div><dt class="mono">Delivers to</dt><dd>{{ countries.size }} countries</dd></div>
        <div><dt class="mono">Prices</dt><dd>{% if cart.currency.iso_code == 'CAD' %}Canadian dollars (CAD){% else %}{{ cart.currency.iso_code }}, converted from Canadian dollars{% endif %}</dd></div>
        <div><dt class="mono">Director</dt><dd><span class="redact" tabindex="0">You, eventually</span></dd></div>
      </dl>
    </div>
    <div class="enlist">
      <span class="tape tape-l" aria-hidden="true"></span><span class="tape tape-r" aria-hidden="true"></span>
      <div class="enl-head">
        <p class="kick mono">Recruitment form</p>
        <h2 class="h2" id="subH">Join the network</h2>
      </div>
      {% render 'mc-newsletter', id: 'contact-news', note: 'Drop alerts, first. One email, your address.' %}
      <span class="stamp pend" style="--r:-6deg" aria-hidden="true">Clearance pending</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Report in (contact)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Other pages that use this template (for example the model signup form) show their own page title instead.", "default": "Report in" },
    { "type": "textarea", "id": "deck", "label": "Intro", "default": "Questions, sizes, collabs or a sighting of someone wearing it better than you. Pick a line." },
    { "type": "text", "id": "form_heading", "label": "Message form heading", "default": "Send a message" },
    { "type": "text", "id": "hq", "label": "Headquarters", "default": "Regina, Saskatchewan, Canada" }
  ],
  "presets": [{ "name": "Report in (contact)" }]
}
{% endschema %}
