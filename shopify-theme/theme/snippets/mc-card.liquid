{%- comment -%}
  Product card, photo first: a 4:5 photo (the next photo crossfades in on hover), name, price, sizes; the file-number evidence tag,
  NEW and SOLD OUT stamps. Used by the shop grid, search, home picks, related products and the bag's suggestions.
  Quick add (outside the link, so the markup stays valid):
    - one variant: one tap adds it ("+" on touch, an "Add to bag" strip on hover);
    - one option (sizes): "+" opens a size sheet (popover, so it works without JavaScript); on desktop the sizes slide up on hover;
    - gift cards, personalised products (template suffix "custom", e.g. Easify), multi-option products and anything tagged
      no-quick-add have no quick add: the card opens the product page.
  With JavaScript, mc-cart.js turns every [data-mc-add] button into an AJAX add that opens the bag; without it the form posts to /cart/add.
  Params: product, i (0-based position, default 0), sizes, widths, feat (true = larger name), data (true = shop data-* attributes),
          photo (1-based photo number override), order (output of mc-order, saves recomputing), quick (false = no quick add),
          uid (unique id suffix when the same product appears twice on one page), eager (true = first photo is the LCP image)
{%- endcomment -%}
{%- liquid
  capture cls
    render 'mc-class', product: product
  endcapture
  capture fno
    render 'mc-fileno', product: product, order: order
  endcapture
  assign num = fno | remove: 'MC-' | plus: 0
  capture sz
    render 'mc-sizes', product: product, cls: cls, range: true
  endcapture
  capture lead
    render 'mc-lead', product: product
  endcapture
  assign pn = photo | default: lead | plus: 0 | minus: 1
  if pn < 0
    assign pn = 0
  endif
  assign pic = product.images[pn] | default: product.featured_image
  assign has2 = false
  if product.images.size > 1
    assign pn2 = pn | plus: 1
    if pn2 >= product.images.size
      assign pn2 = 0
    endif
    if pn2 != pn
      assign pic2 = product.images[pn2]
      assign has2 = true
    endif
  endif
  assign colh = product.collections | map: 'handle'
  assign is_new = false
  if colh contains 'new-arrivals'
    assign is_new = true
  endif
  assign pos = i | default: 0
  if pos > 12
    assign pos = 12
  endif
  case cls
    when 'top'
      assign plural = 'Tops'
    when 'bottom'
      assign plural = 'Bottoms'
    when 'accessory'
      assign plural = 'Hardware'
    when 'gift'
      assign plural = 'Gift cards'
    else
      assign plural = 'Print'
  endcase
  assign hay = product.title | strip | append: ' ' | append: product.type | append: ' ' | append: plural | append: ' ' | append: fno | downcase | escape
  assign ws = widths | default: '360,540,720,960'
  assign sz_attr = sizes | default: '(min-width:1400px) 330px, (min-width:1100px) 24vw, (min-width:700px) 32vw, 48vw'
  # rings shot small on a wide studio frame are cropped in so the ring fills the card (a close-up keeps its framing)
  assign is_ring = false
  assign ring_hay = product.handle | append: ' ' | append: product.type | downcase
  if cls == 'accessory' and ring_hay contains 'ring' and pic.width > 0
    assign pic_ar = pic.width | times: 1.0 | divided_by: pic.height
    if pic_ar > 1.4
      assign is_ring = true
    endif
  endif
  assign ttl = product.title | strip | escape

  assign qa = ''
  assign qa_off = false
  if quick == false
    assign qa_off = true
  endif
  if product.gift_card? or cls == 'gift' or product.template_suffix == 'custom' or product.tags contains 'no-quick-add'
    assign qa_off = true
  endif
  if product.available and qa_off == false
    if product.variants.size == 1
      assign qa = 'one'
    elsif product.options.size == 1 and product.variants.size <= 14
      assign qa = 'size'
    endif
  endif
  if uid != blank
    assign qid = 'qa-' | append: uid
  else
    assign qid = 'qa-' | append: product.id | append: '-' | append: pos
  endif
-%}
<div class="card{% if feat %} feat{% endif %}{% unless product.available %} sold{% endunless %}{% if is_new %} isnew{% endif %}" style="--i:{{ pos }}"{% if data %} data-h="{{ product.handle }}" data-n="{{ hay }}" data-cat="{{ cls }}" data-p="{{ product.price | divided_by: 100.0 }}" data-pub="{{ product.published_at | date: '%s' }}" data-av="{% if product.available %}1{% else %}0{% endif %}" data-no="{{ num }}" data-f="{{ num | minus: 1 }}"{% endif %}>
  <a class="card-a" href="{{ product.url }}">
    <span class="card-ph{% if is_ring %} zoom{% endif %}{% if has2 %} has2{% endif %}">
      {%- render 'mc-img', image: pic, alt: product.title, widths: ws, sizes: sz_attr, eager: eager -%}
      {%- if has2 %}{% render 'mc-img', image: pic2, alt: '', class: 'ph ph2', widths: ws, sizes: sz_attr %}{% endif -%}
      <i class="card-vf" aria-hidden="true"></i>
      <span class="card-tag" aria-hidden="true">{{ fno }}</span>
      {%- if is_new %}<span class="stamp white sm card-new in" style="--r:7deg">New</span>{% endif -%}
      {%- unless product.available %}<span class="stamp white card-oos in" style="--r:-11deg" aria-hidden="true">Sold out</span>{% endunless -%}
    </span>
    <span class="cap">
      <b class="card-t">{{ ttl }}</b>
      <span class="card-m"><span class="pr">{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s> {% endif %}{% render 'mc-price', product: product %} <small>{{ cart.currency.iso_code }}</small></span><span class="sz">{% if product.available %}{{ sz | escape }}{% else %}Sold out{% endif %}</span></span>
    </span>
  </a>
  {%- case qa -%}
    {%- when 'one' -%}
      {%- assign v1 = product.variants.first -%}
      <form class="card-qa" method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8">
        <input type="hidden" name="quantity" value="1">
        <button class="qa-go" type="submit" name="id" value="{{ v1.id }}" data-mc-add="{{ v1.id }}" aria-label="Add {{ ttl }} to bag"><i aria-hidden="true"></i></button>
        <span class="qa-p qa-one"><button class="qa-b" type="submit" name="id" value="{{ v1.id }}" data-mc-add="{{ v1.id }}">Add to bag</button></span>
      </form>
    {%- when 'size' -%}
      {%- assign opt_name = product.options.first | escape -%}
      <div class="card-qa">
        <button class="qa-go" type="button" popovertarget="{{ qid }}" aria-label="Quick add {{ ttl }}"><i aria-hidden="true"></i></button>
        <div class="qa-p" id="{{ qid }}" popover role="dialog" aria-label="{{ ttl }}: choose {{ opt_name | downcase }}">
          {%- comment -%} the sheet closes as soon as a size is picked, so the bag drawer that opens next is not covered {%- endcomment -%}
          <form class="qa-f" method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8" onclick="try{var p=this.closest('[popover]');if(event.target.closest('[data-mc-add]')&&p.matches(':popover-open'))p.hidePopover()}catch(e){}">
            <input type="hidden" name="quantity" value="1">
            <p class="qa-h"><b>{{ ttl }}</b><span>{% render 'mc-price', product: product %} <small>{{ cart.currency.iso_code }}</small></span></p>
            <p class="qa-l">{{ opt_name }}</p>
            <span class="qa-sz">
              {%- for v in product.variants -%}
                {%- assign vl = v.option1 | upcase | escape -%}
                <button class="qa-b" type="submit" name="id" value="{{ v.id }}"{% if v.available %} data-mc-add="{{ v.id }}" aria-label="Add {{ opt_name | downcase }} {{ vl }} to bag"{% else %} disabled aria-label="{{ opt_name }} {{ vl }}, sold out"{% endif %}>{{ vl }}</button>
              {%- endfor -%}
            </span>
          </form>
          <button class="qa-x" type="button" popovertarget="{{ qid }}" popovertargetaction="hide" aria-label="Close"></button>
        </div>
      </div>
  {%- endcase -%}
</div>
