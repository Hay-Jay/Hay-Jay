{%- comment -%}
  The magazine corner card (markup only; timing and memory are in mc-core.js, it never shows without JavaScript).
  A small, non-blocking card in the bottom-left corner, offered once per visitor. Rendered by layout/theme.liquid on browsing pages only
  (home, shop, lookbook, about, shipping, FAQ), never on product, bag or account pages, and not when the magazine is already in the bag. No params.
{%- endcomment -%}
{%- liquid
  capture mag_handle
    render 'mc-magazine'
  endcapture
  if mag_handle != blank
    assign mag = all_products[mag_handle]
  endif
  assign in_bag = false
  if mag
    for item in cart.items
      if item.product_id == mag.id
        assign in_bag = true
        break
      endif
    endfor
  endif
-%}
{%- if mag and mag.available and in_bag == false -%}
  {%- liquid
    capture facts
      render 'mc-magfacts', product: mag
    endcapture
    assign fp = facts | split: '~'
    assign vol = fp[0]
    assign mtitle = mag.title | remove: 'MONOCHROME Magazine — ' | remove: 'MONOCHROME Magazine - ' | remove: ' (Print)' | strip
    assign variant = mag.selected_or_first_available_variant
    assign cover = mag.featured_image
    assign kick = 'New issue'
    if vol != blank
      assign kick = 'Vol. ' | append: vol
    endif
  -%}
<aside class="magpop" id="magpop" role="dialog" aria-modal="false" aria-labelledby="magpopT" data-key="{{ mag.handle }}" hidden>
  <div class="mp-card paper">
    <a class="mp-cover" href="{{ mag.url }}" tabindex="-1" aria-hidden="true">{% render 'mc-img', image: cover, alt: '', class: 'mp-img', sizes: '(min-width:700px) 112px, 84px', widths: '120,180,240' %}<span class="stamp sm mp-stamp" style="--r:-12deg">New</span></a>
    <div class="mp-copy">
      <p class="mp-kick mono"><b class="rec" aria-hidden="true"></b>{{ kick | escape }} <span aria-hidden="true">// Print</span></p>
      <h2 class="mp-t" id="magpopT"><a href="{{ mag.url }}">{{ mtitle | escape }}</a></h2>
      {%- if settings.magpop_line != blank %}<p class="mp-line mono">{{ settings.magpop_line | escape }}</p>{% endif -%}
      <p class="mp-cta">
        <a class="mp-add" href="{{ routes.cart_url }}/{{ variant.id }}:1" data-mc-add="{{ variant.id }}">Add to bag<span class="mp-pr">{{ variant.price | money }}</span></a>
      </p>
    </div>
    <button class="mp-x" type="button" data-close aria-label="Close"><i aria-hidden="true"></i></button>
  </div>
</aside>
{%- endif -%}
