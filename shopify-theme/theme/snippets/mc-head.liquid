{%- assign tk_search_term_string = '{search_term_string}' -%}
{%- comment -%} <title>, description, canonical, social tags, structured data for the whole site. Param: key (page key from the layout). {%- endcomment -%}
{%- liquid
  assign site_name = 'MONOCHROME®'
  if template.name == 'index'
    assign ttl = 'OPERATION: WEAR THE UNKNOWN — Mission briefing — MONOCHROME® Bureau'
    assign desc = page_description | default: 'Operation: Wear the Unknown. MONOCHROME® Division of Wearables issues black, white and chrome clothing, rings and chains in small runs, delivered to countries including Nigeria and Canada.'
  else
    assign ttl = page_title
    if template.name == 'collection'
      # the register keeps one name; filters in mc-shop.js prefix it with the class ("Tops — Asset Register — ...")
      if collection.handle == 'all'
        assign ttl = 'Asset Register'
      else
        assign ttl = collection.title | append: ' — Asset Register'
      endif
    endif
    if current_page != 1
      assign ttl = ttl | append: ' — Page ' | append: current_page
    endif
    if template.name == 'collection'
      assign ttl = ttl | append: ' — MONOCHROME® Bureau'
    else
      assign ttl = ttl | append: ' — ' | append: site_name
    endif
    assign desc = page_description | default: shop.description | default: 'MONOCHROME® is a black, white and chrome clothing brand, delivered to countries including Nigeria and Canada.'
  endif
  if template.name == 'product' and product.featured_image
    assign og_src = product.featured_image | image_url: width: 1200
  elsif template.name == 'collection' and collection.image
    assign og_src = collection.image | image_url: width: 1200
  elsif settings.logo_emblem
    assign og_src = settings.logo_emblem | image_url: width: 600
  else
    assign og_src = 'mc-emblem.webp' | asset_url
  endif
  if og_src contains 'https:'
    assign og_abs = og_src
  else
    assign og_abs = og_src | prepend: 'https:'
  endif
-%}
<title>{{ ttl | strip | escape_once }}</title>
<meta name="description" content="{{ desc | strip_html | strip_newlines | strip | escape }}">
<link rel="canonical" href="{{ canonical_url }}">
{%- if template.name == 'search' or template.name contains 'customers' or template.name == 'cart' %}
<meta name="robots" content="noindex">
{%- endif %}
<meta property="og:site_name" content="{{ site_name }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
<meta property="og:title" content="{{ ttl | strip | escape_once }}">
<meta property="og:description" content="{{ desc | strip_html | strip_newlines | strip | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:image" content="{{ og_abs }}">
<meta name="twitter:card" content="{% if template.name == 'product' or template.name == 'collection' %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ ttl | strip | escape_once }}">
<meta name="twitter:description" content="{{ desc | strip_html | strip_newlines | strip | escape }}">
{%- if template.name == 'product' %}
<meta property="product:price:amount" content="{{ product.price | money_without_currency | strip }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
{%- if template.name == 'index' %}
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "Organization", "name": "MONOCHROME", "url": {{ shop.url | append: '/' | json }}, "logo": {{ og_abs | json }}, "sameAs": [{% if settings.social_instagram != blank %}{{ settings.social_instagram | json }}{% endif %}], "email": {{ settings.contact_email | json }} }
</script>
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "WebSite", "name": "MONOCHROME®", "url": {{ shop.url | append: '/' | json }},
  "potentialAction": { "@type": "SearchAction", "target": {{ shop.url | append: '/search?q=' | append: tk_search_term_string | json }}, "query-input": "required name=search_term_string" } }
</script>
{%- endif %}
