{%- comment -%} <title>, description, canonical, social tags, structured data for the whole site. Param: key (page key from the layout). {%- endcomment -%}
{%- liquid
  assign site_name = 'MONOCHROME®'
  if template.name == 'index'
    assign ttl = 'OPERATION: WEAR THE UNKNOWN — Mission briefing — MONOCHROME® Bureau'
    assign desc = page_description | default: 'Operation: Wear the Unknown. MONOCHROME® Division of Wearables issues black, white and chrome clothing, rings and chains in small runs. Prices in CAD, delivered to countries including Nigeria and Canada.'
  else
    assign ttl = page_title
    if current_page != 1
      assign ttl = ttl | append: ' — Page ' | append: current_page
    endif
    assign ttl = ttl | append: ' — ' | append: site_name
    assign desc = page_description | default: shop.description | default: 'MONOCHROME® is a black, white and chrome clothing brand. Prices in CAD, delivered to countries including Nigeria and Canada.'
  endif
  if template.name == 'product' and product.featured_image
    assign og_src = product.featured_image | image_url: width: 1200
  elsif template.name == 'collection' and collection.image
    assign og_src = collection.image | image_url: width: 1200
  elsif settings.logo_emblem
    assign og_src = settings.logo_emblem | image_url: width: 600
  else
    assign og_src = 'mc-emblem.webp' | asset_url
  endif
  if og_src contains 'https:'
    assign og_abs = og_src
  else
    assign og_abs = og_src | prepend: 'https:'
  endif
-%}
<title>{{ ttl | strip | escape }}</title>
<meta name="description" content="{{ desc | strip_html | strip_newlines | strip | escape }}">
<link rel="canonical" href="{{ canonical_url }}">
{%- if template.name == 'search' or template.name contains 'customers' or template.name == 'cart' %}
<meta name="robots" content="noindex">
{%- endif %}
<meta property="og:site_name" content="{{ site_name }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
<meta property="og:title" content="{{ ttl | strip | escape }}">
<meta property="og:description" content="{{ desc | strip_html | strip_newlines | strip | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:image" content="{{ og_abs }}">
<meta name="twitter:card" content="{% if template.name == 'product' or template.name == 'collection' %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ ttl | strip | escape }}">
<meta name="twitter:description" content="{{ desc | strip_html | strip_newlines | strip | escape }}">
{%- if template.name == 'product' %}
<meta property="product:price:amount" content="{{ product.price | money_without_currency | strip }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
{%- if template.name == 'index' %}
<script type="application/ld+json">
{{ '{"@context":"https://schema.org","@type":"Organization","name":"MONOCHROME","url":"' | append: shop.url | append: '/","logo":"' | append: og_abs | append: '","sameAs":["' | append: settings.social_instagram | append: '"],"email":"' | append: settings.contact_email | append: '"}' }}
</script>
<script type="application/ld+json">
{{ '{"@context":"https://schema.org","@type":"WebSite","name":"MONOCHROME®","url":"' | append: shop.url | append: '/","potentialAction":{"@type":"SearchAction","target":"' | append: shop.url | append: '/search?q={search_term_string}","query-input":"required name=search_term_string"}}' }}
</script>
{%- endif %}
