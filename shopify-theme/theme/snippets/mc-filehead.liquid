{%- comment -%} File header card. Params: file, doc, page (number, seeds the barcode), level (1-5), extra (optional text), seed (number). Pages use the one-line .pg-head instead. {%- endcomment -%}
{%- assign sd = seed | default: page | times: 101 -%}
<div class="filehead mono"><span class="fh-c"><b>File no.</b>{{ file | escape }}</span><span class="fh-c"><b>Document</b>{{ doc | escape }}</span>{%- if extra != blank -%}<span class="fh-c"><b>Note</b>{{ extra | remove_first: ' — ' | escape }}</span>{%- endif -%}<span class="fh-c fh-clr"><b>Clearance</b>{% render 'mc-ladder', n: level %}<em>L{{ level }}</em></span><span class="fh-bc">{% render 'mc-barcode', seed: sd %}</span></div>
