{%- comment -%}
  Which page this is. No params. Output: key~folio~level~doc~navurl
  folio = the page's file number (MC-1xx, 0 = none), level = clearance 1-5 (a micro-label), navurl = the header or help link to highlight.
{%- endcomment -%}
{%- liquid
  # anything not listed below (policies, plain pages) is an unnumbered document that highlights no link
  assign key = 'page'
  assign folio = 0
  assign level = 1
  assign doc = 'Document'
  assign nav = '-'
  case template.name
    when 'index'
      assign key = 'home'
      assign folio = 1
      assign level = 5
      assign doc = 'Home'
      assign nav = '/'
    when 'collection'
      assign key = 'shop'
      assign folio = 2
      assign level = 3
      assign doc = 'Shop'
      assign nav = routes.all_products_collection_url
      if collection.handle == 'new-arrivals'
        assign doc = 'New in'
        assign nav = collection.url
      endif
    when 'list-collections'
      assign key = 'shop'
      assign folio = 2
      assign level = 3
      assign doc = 'Shop'
      assign nav = routes.all_products_collection_url
    when 'search'
      assign key = 'shop'
      assign folio = 2
      assign level = 3
      assign doc = 'Search'
      assign nav = routes.all_products_collection_url
    when 'product'
      assign key = 'product'
      assign folio = 2
      assign level = 4
      assign doc = 'Product'
      assign nav = routes.all_products_collection_url
    when 'cart'
      assign key = 'cart'
      assign folio = 2
      assign level = 3
      assign doc = 'Bag'
      assign nav = routes.all_products_collection_url
    when '404'
      assign key = '404'
      assign folio = 0
      assign level = 0
      assign doc = 'Not found'
      assign nav = '-'
    when 'page'
      case template.suffix
        when 'lookbook'
          assign key = 'lookbook'
          assign folio = 3
          assign level = 4
          assign doc = 'Lookbook'
          assign nav = '/pages/lookbook'
        when 'about'
          assign key = 'about'
          assign folio = 4
          assign level = 5
          assign doc = 'About'
          assign nav = '/pages/about'
        when 'shipping'
          assign key = 'shipping'
          assign folio = 5
          assign level = 3
          assign doc = 'Shipping'
          assign nav = '/pages/shipping'
        when 'faq'
          assign key = 'faq'
          assign folio = 6
          assign level = 2
          assign doc = 'FAQ'
          assign nav = '/pages/faq'
        when 'contact'
          assign key = 'contact'
          assign folio = 7
          assign level = 1
          assign doc = 'Contact'
          assign nav = page.url
        when 'portfolio'
          assign folio = 8
          assign level = 4
          assign doc = 'Team'
          assign nav = '/pages/about'
        when 'vision-issue'
          assign folio = 16
          assign level = 5
          assign doc = 'The Vision Issue'
          assign nav = '/pages/vision-issue'
      endcase
  endcase
-%}
{{- key }}~{{ folio }}~{{ level }}~{{ doc }}~{{ nav -}}
