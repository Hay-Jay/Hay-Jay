{%- comment -%} Plain text with **bold** markers -> escaped HTML with <b class="lead-in">. Param: text. {%- endcomment -%}
{%- assign parts = text | split: '**' -%}
{%- for part in parts -%}{%- assign m = forloop.index | modulo: 2 -%}{%- if m == 0 -%}<b class="lead-in">{{ part | escape }}</b>{%- else -%}{{ part | escape }}{%- endif -%}{%- endfor -%}
