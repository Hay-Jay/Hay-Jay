{%- comment -%}
  Responsive photo. Params: image, alt, class (default ph), widths (comma list, default 480,720,1080), sizes (default 100vw), eager (true = LCP image), lazy (false = load with the page, no priority), id.
{%- endcomment -%}
{%- liquid
  assign ws = widths | default: '480,720,1080' | split: ','
  assign mid_i = ws.size | divided_by: 2
  assign mid = ws[mid_i] | strip | plus: 0
-%}
<img class="{{ class | default: 'ph' }}"{% if id != blank %} id="{{ id }}"{% endif %}{% if eager %} fetchpriority="high"{% elsif lazy == false %}{% else %} loading="lazy"{% endif %} decoding="async" draggable="false" src="{{ image | image_url: width: mid }}" srcset="{%- for w in ws -%}{%- assign wn = w | strip | plus: 0 -%}{{ image | image_url: width: wn }} {{ wn }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}" sizes="{{ sizes | default: '100vw' }}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ alt | escape }}">
